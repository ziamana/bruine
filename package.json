{
  "name": "@ziamana/bruine",
  "version": "0.1.7",
  "description": "Interactive terminal coding agent that runs your own models, local or OpenAI-compatible",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziamana/bruine.git"
  },
  "homepage": "https://github.com/ziamana/bruine#readme",
  "bugs": {
    "url": "https://github.com/ziamana/bruine/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-assistant",
    "llm",
    "local-llm",
    "llama.cpp",
    "openai-compatible",
    "terminal",
    "tui"
  ],
  "bin": {
    "bruine": "dist/bin.js",
    "kumo": "dist/bin.js"
  },
  "exports": {
    "./startup": "./dist/plugins/startup.js",
    "./repl": "./dist/plugins/repl.js",
    "./headless": "./dist/plugins/headless.js",
    "./render": "./dist/plugins/render.js",
    "./approval": "./dist/plugins/approval.js",
    "./herdr": "./dist/plugins/herdr.js",
    "./modes": "./dist/plugins/modes.js",
    "./web-search": "./dist/plugins/web-search.js",
    "./mcp": "./dist/plugins/mcp.js",
    "./silence": "./dist/plugins/silence.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./compat": "./dist/compat.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.2",
  "files": [
    "dist",
    "skills",
    "THIRD_PARTY_NOTICES.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "bench": "node --experimental-strip-types --import ./bench/ts-hooks.mjs bench/run.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "vitest run test/e2e"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.3",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.3",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.3",
    "@deepseek-ai/dsh-cmdline": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/dsh-mcp-client": "0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "0.1.5-rc.3",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "jpeg-js": "0.4.4",
    "string-width": "^8.3.0",
    "yaml": "^2.9.1"
  }
}
