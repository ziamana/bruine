{
  "name": "kumo-cli",
  "version": "0.0.1",
  "description": "Interactive terminal agent built on DeepSeek Harness (dsh)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "kumo": "dist/bin.js"
  },
  "exports": {
    "./startup": "./dist/plugins/startup.js",
    "./repl": "./dist/plugins/repl.js",
    "./render": "./dist/plugins/render.js",
    "./approval": "./dist/plugins/approval.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.2",
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@earendil-works/pi-tui": "0.85.1",
    "commander": "^15.0.0",
    "string-width": "^8.3.0"
  }
}
