{
  "name": "bruine-promo",
  "private": true,
  "version": "0.0.1",
  "description": "Bruine's presentation video, made with Remotion",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "still": "remotion still BruinePromo",
    "render": "remotion render BruinePromo out/bruine-promo.mp4",
    "typecheck": "tsc --noEmit",
    "check:copy": "node scripts/check-copy.mjs",
    "check": "npm run typecheck && npm run check:copy"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
